+authors = ["https://hipfire.dev"]
 version.workspace = true
 edition.workspace = true
 license.workspace = true
diff --git a/crates/hipfire-tui/Cargo.toml b/crates/hipfire-tui/Cargo.toml
index d044d816c..40271de88 100644
--- a/crates/hipfire-tui/Cargo.toml
+++ b/crates/hipfire-tui/Cargo.toml
@@ -3,6 +3,8 @@ name = "hipfire-tui"
