diff --git a/gemma.sh b/gemma.sh
new file mode 100755
index 000000000..f38e8fedc
--- /dev/null
+++ b/gemma.sh
@@ -0,0 +1,17 @@
+#!/bin/sh
+PT=$( dirname "$0" )
+LLM_PT=/usr/share/llm
+
+# Other models:
+#LLM="-m ${LLM_PT}/gemma-4-E4B-it-Q4_K_M.gguf -mm ${LLM_PT}/mmproj-F16.gguf"
+#LLM="-m ${LLM_PT}/gemma-4-26B-A4B-it-UD-Q3_K_M.gguf -mm ${LLM_PT}/gemma-4-26B-mmproj-F16.gguf"
+#LLM="-m ${LLM_PT}/Qwen3-Coder-30B-A3B-Instruct-UD-IQ2_M.gguf"
+#LLM="-hf unsloth/flint-GGUF:UD-IQ2_XXS"
+
+if ! lsof -Pi :8001 -sTCP:LISTEN -t >/dev/null ; then
+    trap 'trap - SIGTERM && kill 0' SIGINT SIGTERM EXIT
+    uvx mcp-proxy --named-server-config ${PT}/mcp_config.json --allow-origin "*" --port 8001 --stateless &
+fi
+
+(sleep 5; firefox -new-tab "http://127.0.0.1:8084") &
+GGML_CUDA_ENABLE_UNIFIED_MEMORY=1 ${PT}/build/bin/llama-server --port 8084 --models-preset $PT/models.ini
