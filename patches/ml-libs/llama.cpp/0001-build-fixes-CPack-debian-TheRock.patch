diff --git a/bench.sh b/bench.sh
new file mode 100755
index 000000000..799dee625
--- /dev/null
+++ b/bench.sh
@@ -0,0 +1,8 @@
+#!/bin.sh
+# Tune Llama's parameters for max token generations
+# https://github.com/ggml-org/llama.cpp/blob/master/tools/llama-bench/README.md
+
+LLM="-hf unsloth/gemma-4-26B-A4B-it-GGUF:IQ3_XXS"
+
+llama-bench ${LLM} --device ROCm0 --n-cpu-moe 8 -ngl -1 -lm none
+#llama-bench ${LLM} --device Vulkan0 --n-cpu-moe 0,8,10 -ngl -1,20,30 -lm mmap,none -fa 0,1
diff --git a/deb/llama-vscode.service b/deb/llama-vscode.service
new file mode 100644
index 000000000..e5d3b213e
--- /dev/null
+++ b/deb/llama-vscode.service
@@ -0,0 +1,18 @@
+[Unit]
+Description=LLM-assisted text completion for VS Code
+After=network.target
+
+[Service]
+Type=simple
+User=root
+WorkingDirectory=/tmp
+ExecStart=/usr/bin/llama-server --port 8084 --models-preset /usr/share/llm/models.ini
+Environment="GGML_CUDA_ENABLE_UNIFIED_MEMORY=1"
+Restart=always
+RestartSec=30
+StandardOutput=syslog
+StandardError=syslog
+SyslogIdentifier=%n
+
+[Install]
+WantedBy=multi-user.target
