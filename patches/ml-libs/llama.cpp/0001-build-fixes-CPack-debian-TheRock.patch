+++ b/deb/mcp.service
@@ -0,0 +1,18 @@
+[Unit]
+Description=MCP servers for Large Language Models (LLM)
+After=network.target
+
+[Service]
+Type=simple
+User=root
+WorkingDirectory=/tmp
+ExecStart=uvx mcp-proxy --named-server-config /usr/share/llm/mcp_config.json --allow-origin "*" --port 8001 --stateless
+Environment="GGML_CUDA_ENABLE_UNIFIED_MEMORY=1"
+Restart=always
+RestartSec=30
+StandardOutput=syslog
+StandardError=syslog
+SyslogIdentifier=%n
+
+[Install]
+WantedBy=multi-user.target
