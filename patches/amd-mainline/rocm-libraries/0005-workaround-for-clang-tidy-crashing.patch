From 91c80e38de80e7c6e1119dc56ab7e03ef8b43825 Mon Sep 17 00:00:00 2001
From: Thijs Withaar <thijs.withaar@gmail.com>
Date: Wed, 20 May 2026 19:55:49 +0200
Subject: [PATCH] workaround for clang-tidy crashing

---
 projects/miopen/CMakeLists.txt | 13 ++-----------
 1 file changed, 2 insertions(+), 11 deletions(-)

diff --git a/projects/miopen/CMakeLists.txt b/projects/miopen/CMakeLists.txt
index af87cd1c7e..ab647f6332 100644
--- a/projects/miopen/CMakeLists.txt
+++ b/projects/miopen/CMakeLists.txt
@@ -774,17 +774,8 @@ elseif(MIOPEN_BACKEND STREQUAL "HIP" OR MIOPEN_BACKEND STREQUAL "HIPNOGPU")
     set(MIOPEN_TIDY_ERRORS ALL)
 endif()
 
-include(ClangTidy)
-enable_clang_tidy(
-    CHECKS
-        ${MIOPEN_TIDY_CHECKS}
-    ${MIOPEN_TIDY_ERRORS}
-    HEADER_FILTER
-        "\.hpp$"
-    EXTRA_ARGS
-        -DMIOPEN_USE_CLANG_TIDY
-        -D__builtin_elementwise_exp10=__builtin_elementwise_exp
-)
+function(clang_tidy_check a)
+endfunction()
 
 include(CppCheck)
 enable_cppcheck(
-- 
