From ced339d1e4b63a64476d5d4af6dfe282fbc38849 Mon Sep 17 00:00:00 2001
From: Thijs Withaar <thijs.withaar@gmail.com>
Date: Fri, 30 Oct 2026 21:26:34 +0100
Subject: [PATCH] Debian package fixups

---
 CMakeLists.txt | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 16fe3146..560e0581 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -935,6 +935,10 @@ include(GNUInstallDirs)
 
 # Legacy module (hipSYCL)
 
+set(CPACK_PACKAGE_NAME acpp)
+set(CPACK_DEBIAN_PACKAGE_NAME acpp)
+set(CPACK_PACKAGE_CONTACT aksel.alpay@uni-heidelberg.de)
+
 
 set(HIPSYCL_INSTALL_CMAKE_DIR
   "lib/cmake/hipSYCL" CACHE PATH "Install path for legacy CMake config files")
@@ -1073,7 +1077,13 @@ install(EXPORT install_exports
   DESTINATION ${ADAPTIVECPP_INSTALL_CMAKE_DIR}
 )
 
+if(UNIX)
+  file(WRITE ${PROJECT_BINARY_DIR}/30-adaptivecpp.conf "/usr/lib/hipSYCL\n")
+  install(FILES ${PROJECT_BINARY_DIR}/30-adaptivecpp.conf COMPONENT ACPP DESTINATION /etc/ld.so.conf.d)
+endif()
+
 mark_as_advanced(
   ADAPTIVECPP_INSTALL_CMAKE_DIR
 )
 
+include(CPack)
-- 
